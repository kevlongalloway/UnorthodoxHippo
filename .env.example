# Précis — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Render auto-sets this in production)
DATABASE_URL=postgresql://precis_user:password@localhost:5432/precis

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of allowed origins (or * for local dev)
CLIENT_ORIGIN=http://localhost:5173

# ── Anthropic (Synopsis Engine) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Rate limit for /api/synopsis (requests per minute per IP)
RATE_LIMIT_PER_MIN=10

# ── Clerk Authentication (activate when going to production) ──────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Prefix with VITE_ so Vite exposes them to client-side code
VITE_API_URL=http://localhost:3001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

// Précis — Database Schema
// ORM: Prisma  |  Database: PostgreSQL (Render managed)
//
// Priority tiers (from technical brief):
//   P0 — Beta launch:        User, Post, Book, Follow, Like, Shelf, UserBook, InkEvent
//   P1 — First month:        Notification, Conversation, Message
//   P2 — Incremental:        BookClub, ClubMember, Waypoint, Challenge, Import

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════
// P0 — Core tables (required for beta launch)
// ═══════════════════════════════════════════════════════

model User {
  id             String    @id @default(cuid())
  clerkId        String    @unique  // Clerk user ID (production auth)
  handle         String    @unique  // @username
  name           String
  bio            String?
  avatarUrl      String?
  lens           String    @default("analyst")   // default reading lens
  ink            Int       @default(0)            // reputation score
  foundingMember Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  posts          Post[]
  shelves        Shelf[]
  userBooks      UserBook[]
  inkEvents      InkEvent[]
  following      Follow[]          @relation("Follower")
  followers      Follow[]          @relation("Following")
  likes          Like[]
  notifications  Notification[]    @relation("NotifRecipient")
  sentMessages   Message[]
  conversations  ConversationParticipant[]
  waypoints      Waypoint[]
  challenges     Challenge[]
  clubMemberships ClubMember[]
  imports        Import[]

  @@index([handle])
  @@index([createdAt])
}

model Post {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Content
  body        String    // main text content
  contentType String    @default("review")    // review | recommendation | original | spoiler
  lens        String    @default("analyst")   // reading lens used

  // Book association (optional — original works may not reference a book)
  bookId      String?
  book        Book?     @relation(fields: [bookId], references: [id])
  bookPosition String?  // page, chapter, or % when waypoint was set

  // Attestation / Copyright flags
  isAttestedOriginal Boolean @default(false)
  hasSpoilers        Boolean @default(false)
  spoilerPage        String?

  // Tags
  tags        String[]  @default([])

  // Metrics (denormalized for fast reads)
  likeCount   Int       @default(0)
  repostCount Int       @default(0)
  replyCount  Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  likes       Like[]
  waypoints   Waypoint[]

  @@index([authorId, createdAt])
  @@index([bookId, createdAt])
  @@index([contentType])
}

model Book {
  id          String    @id @default(cuid())
  title       String
  author      String
  isbn        String?   @unique
  coverUrl    String?
  genre       String?
  year        Int?
  pageCount   Int?
  description String?

  createdAt   DateTime  @default(now())

  posts       Post[]
  userBooks   UserBook[]
  waypoints   Waypoint[]

  @@index([title])
  @@index([author])
}

model Follow {
  id          String    @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime  @default(now())

  follower    User      @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following   User      @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// Reading shelf — a user's curated list of books
model Shelf {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBooks   UserBook[]

  @@index([userId])
}

// Junction: user ↔ book (reading status, shelf placement)
model UserBook {
  id          String    @id @default(cuid())
  userId      String
  bookId      String
  shelfId     String?

  status      String    @default("want")  // want | reading | read | abandoned
  startedAt   DateTime?
  finishedAt  DateTime?
  currentPage Int?
  rating      Int?      // 1–5

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book      @relation(fields: [bookId], references: [id])
  shelf       Shelf?    @relation(fields: [shelfId], references: [id])

  @@unique([userId, bookId])
  @@index([userId, status])
}

// Ink reputation events — audit trail for score changes
model InkEvent {
  id          String   @id @default(cuid())
  userId      String
  delta       Int      // positive or negative
  reason      String   // e.g. "post_liked", "waypoint_created", "review_attested"
  refId       String?  // optional FK to the triggering entity
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════
// P1 — First month
// ═══════════════════════════════════════════════════════

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  type        String   // like | follow | mention | reply | challenge_invite
  actorId     String?  // the user who triggered the notification
  refId       String?  // entity ID (post, challenge, etc.)
  body        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient   User     @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read, createdAt])
}

model Conversation {
  id           String    @id @default(cuid())
  // Optional: shared book context (from "Messages" feature with book embed)
  sharedBookId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ═══════════════════════════════════════════════════════
// P2 — Incremental features
// ═══════════════════════════════════════════════════════

// Reading waypoints — Compass Engine saves / community shares
model Waypoint {
  id          String   @id @default(cuid())
  userId      String
  bookId      String
  postId      String?
  position    String   // page, chapter, or %
  lens        String
  content     String   // AI-generated or user-written annotation
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book     @relation(fields: [bookId], references: [id])
  post        Post?    @relation(fields: [postId], references: [id])

  @@index([bookId, position])
  @@index([userId])
}

model BookClub {
  id          String    @id @default(cuid())
  name        String
  description String?
  ownerId     String
  isPrivate   Boolean   @default(false)
  currentBook String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     ClubMember[]

  @@index([ownerId])
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      String   @default("member")  // owner | moderator | member
  joinedAt  DateTime @default(now())

  club      BookClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

model Challenge {
  id          String    @id @default(cuid())
  creatorId   String
  title       String
  description String?
  goalType    String    // books_count | pages_count | genre | custom
  goalValue   Int?
  startDate   DateTime
  endDate     DateTime?
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  creator     User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([startDate])
}

// Library imports (Goodreads / StoryGraph CSV)
model Import {
  id          String   @id @default(cuid())
  userId      String
  source      String   // goodreads | storygraph
  status      String   @default("pending")  // pending | processing | done | failed
  booksTotal  Int      @default(0)
  booksAdded  Int      @default(0)
  errorLog    String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
